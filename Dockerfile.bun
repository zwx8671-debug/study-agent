# 使用 Bun 作为构建基础镜像
FROM oven/bun:1 AS builder

# 接收构建参数
ARG BUN_MIRROR=https://registry.npmmirror.com

# 设置工作目录
WORKDIR /app

# 配置 Bun 镜像源（使用环境变量方式）
ENV BUN_CONFIG_REGISTRY=${BUN_MIRROR}

# 配置apt使用阿里云镜像源并安装构建依赖
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y \
    pkg-config \
    libpq-dev \
    libasound2-dev \
    && rm -rf /var/lib/apt/lists/*

# 复制package.json和yarn.lock
COPY package.json yarn.lock ./

# 使用 Bun 安装所有依赖（包括开发依赖）
# Bun 的安装速度比 npm/yarn 快很多
RUN bun install --frozen-lockfile

# 复制所有源代码
COPY . .

# 使用 Bun 构建应用
# 直接使用 package.json 中的构建脚本
RUN bun run build

# 生产环境镜像 - 使用 Bun Alpine 版本
FROM oven/bun:1-alpine

# 接收构建参数
ARG BUN_MIRROR=https://registry.npmjs.org/

# 设置工作目录
WORKDIR /app

# 配置 Bun 镜像源（使用环境变量方式）
ENV BUN_CONFIG_REGISTRY=${BUN_MIRROR}

# 配置Alpine使用阿里云镜像源并更新包索引
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories && \
    apk update

# 从构建阶段复制编译后的代码和依赖
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/assets ./assets
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# 设置环境变量
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

# Bun 性能优化环境变量
ENV BUN_RUNTIME=bun
ENV BUN_COMPILE_CACHE=1
ENV BUN_INSTALL_CACHE_DIR=/tmp/bun-cache

# 暴露端口
EXPOSE 3000

# 使用 Bun 启动应用
# Bun 的启动速度比 Node.js 快 3-4 倍，内存使用更少
CMD ["bun", "run", "dist/src/app.js"]