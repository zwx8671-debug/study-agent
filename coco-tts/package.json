{
    "name": "coco-tts",
    "version": "1.0.0",
    "description": "TTS (Text-to-Speech) microservice for CoCo project, supporting Volcengine, Qwen, Azure and Mock providers via Socket.IO (uWebSockets.js + msgpack) and HTTP.",
    "main": "dist/src/app.js",
    "author": "LeapWatt",
    "license": "MIT",
    "scripts": {
        "local": "chcp 65001 >nul & tsx src/app.ts",
        "dev": "chcp 65001 >nul & dotenv -e .env -e .env.development tsx src/app.ts",
        "build": "tsc && tsc-alias && npm run copy-assets",
        "copy-assets": "node -e \"const fs = require('fs'); const path = require('path'); const src = path.join(__dirname, 'assets'); const dest = path.join(__dirname, 'dist', 'assets'); if (!fs.existsSync(path.dirname(dest))) fs.mkdirSync(path.dirname(dest), { recursive: true }); fs.cpSync(src, dest, { recursive: true }); console.log('Assets copied successfully!');\"",
        "typecheck": "tsc --noEmit",
        "start:win:local": "powershell -Command \"chcp 65001 >$null; $env:NODE_ENV='local'; node --enable-source-maps dist/src/app.js\"",
        "start:win:relocal": "npm run build && npm run start:win:local",
        "start:prod": "node --enable-source-maps dist/src/app.js",
        "start": "node --enable-source-maps dist/src/app.js",
        "pm2:start": "pm2 start ecosystem.config.cjs",
        "pm2:stop": "pm2 stop coco-tts",
        "pm2:reload": "node scripts/pm2-reload.cjs",
        "pm2:rotate": "node scripts/pm2-rotate-daily.cjs",
        "pm2:delete": "pm2 delete coco-tts coco-tts-log-rotate",
        "pm2:logs": "pm2 logs coco-tts",
        "pm2:status": "pm2 status",
        "lint": "eslint ./src --ext .ts",
        "format": "prettier --write ./src",
        "test:socketio": "chcp 65001 >nul & tsx test/socketio-client-test.ts",
        "test:http": "chcp 65001 >nul & tsx test/http-api-test.ts",
        "docker:build": "docker build -t coco-tts:latest .",
        "docker:run": "docker run -p 3003:3003 -p 3002:3002 --env-file .env coco-tts:latest"
    },
    "dependencies": {
        "@fastify/cors": "8.x",
        "@volcengine/openapi": "^1.31.1",
        "axios": "^1.13.4",
        "date-fns": "^4.1.0",
        "date-fns-tz": "^3.2.0",
        "dotenv": "^17.2.1",
        "fastify": "4.x",
        "microsoft-cognitiveservices-speech-sdk": "^1.46.0",
        "pino": "^9.9.0",
        "pino-pretty": "^13.1.1",
        "pino-roll": "^3.1.0",
        "reflect-metadata": "^0.2.2",
        "socket.io": "^4.8.1",
        "socket.io-msgpack-parser": "^3.0.2",
        "tslib": "^2.8.1",
        "uWebSockets.js": "uNetworking/uWebSockets.js#v20.52.0",
        "uuid": "^13.0.0",
        "ws": "^8.16.0"
    },
    "devDependencies": {
        "@types/node": "^24.3.0",
        "@types/ws": "^8.5.10",
        "@typescript-eslint/eslint-plugin": "^8.39.1",
        "@typescript-eslint/parser": "^8.39.1",
        "dotenv-cli": "^10.0.0",
        "eslint": "^9.33.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "pm2": "^6.0.14",
        "prettier": "^3.6.2",
        "socket.io-client": "^4.8.3",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.20.4",
        "typescript": "^5.9.2"
    }
}
