# 开发环境模板（纳入版本管理，禁止填写密钥；密钥请写在 .env 中）
NODE_ENV=development
LOG_LEVEL=info
LOG_TARGET=stdout

# Fastify HTTP API 端口
PORT=3003
# Socket.IO（uWebSockets.js）端口
SOCKETIO_PORT=3002
PATH_PREFIX=

# TTS 实现：volcengine | azure | qwen | mock
TTS_SERVICE_TYPE=volcengine

# ============ 火山引擎（字节 OpenSpeech）============
VOICE_API=wss://openspeech.bytedance.com
VOICE_TTS_RESOURCE_ID=volc.service_type.10029

# ============ Qwen（阿里云百炼，中国区，北京）============
# 密钥写在 .env，这里只放非敏感默认值
QWEN_TTS_MODEL=qwen-audio-3.0-tts-flash
QWEN_TTS_DEFAULT_SPEAKER=longanhuan_v3.6
QWEN_TTS_SAMPLE_RATE=16000

# ============ Azure ============
SPEECH_REGION=eastus

TTS_WS_TIMEOUT=10000

SAVE_PCM=false
SAVE_PCM_DIR=./logs/pcm

CORS_ORIGIN=*
