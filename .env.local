# ==========================================
# Mock 服务配置
# ==========================================

# STT 服务类型（语音转文本）
# 可选值: volcengine | azure | mock
# 默认: volcengine
STT_SERVICE_TYPE=mock

# TTS 服务类型（文本转语音）
# 可选值: volcengine | azure | mock
# 默认: volcengine
TTS_SERVICE_TYPE=mock

# 是否使用 Mock LLM（大语言模型）
# 设置为 true 将使用 MockLLMService 替代真实的 AI 调用
# 默认: false
USE_MOCK_LLM=true

# ==========================================
# Mock 模式说明
# ==========================================
#
# 启用 Mock 模式后：
#
# 1. STT（语音转文本）
#    - 不会真正识别音频内容
#    - 随机返回预设的 10 条中文文本之一
#    - 模拟内存消耗和事件循环
#
# 2. LLM（大语言模型）
#    - 不会调用真实的 AI API
#    - 随机返回预设的 8 段长文本之一
#    - 逐字流式输出（每字 10-50ms 延迟）
#
# 3. TTS（文本转语音）
#    - 不会真正合成语音
#    - 返回预设的音频 Buffer 数据
#    - 模拟真实的音频流输出
#
# ==========================================
# 适用场景
# ==========================================
#
# ✅ 开发测试：快速验证业务逻辑，不依赖外部 API
# ✅ 压力测试：测试系统并发能力和性能
# ✅ 演示培训：无需真实 API 凭证即可演示功能
# ✅ CI/CD：在持续集成环境中运行自动化测试
#
# ⚠️ 注意：Mock 模式仅用于开发和测试，不要在生产环境使用！

# 是否启用 TTS（如果为 false，只会使用 LLM 不会转语音）
ENABLE_TTS=true

# 调试模式,主要保存对话的FuncToken（AUDIO、CHAT）
DEBUG=false

# 是否保存 PCM 音频文件（用于调试）
SAVE_PCM=false

# Vector 快速响应开关
ENABLE_VECTOR=false

# 日志输出目标配置：stdout（标准输出，适合容器）或 file（文件）
LOG_TARGET=file