{
    "name": "coco-cloud-ts",
    "version": "1.0.0",
    "description": "Use fastify.js to build cloud ghost shell services for CoCo project.",
    "main": "app.js",
    "repository": "ssh://git@192.168.10.214:222/ai_software/coco-cloud-ts.git",
    "author": "LeapWatt",
    "license": "MIT",
    "scripts": {
        "local": "chcp 65001 >nul & tsx src/app.ts",
        "local3001": "chcp 65001 >nul & tsx src/app.ts",
        "dev": "chcp 65001 >nul & dotenv -e .env -e .env.development tsx src/app.ts",
        "test:cocoadmin": "chcp 65001 >nul & tsx ./test/httpdap-service-test.ts",
        "test:refact:dialog": "chcp 65001 >nul & tsx ./test/refact/conversation-dialog-httpdao.test.ts",
        "test:refact:messages": "chcp 65001 >nul & tsx ./test/refact/conversation-messages-httpdao.test.ts",
        "test:refact:face": "chcp 65001 >nul & tsx ./test/refact/device-face-httpdao.test.ts",
        "test:refact:product": "chcp 65001 >nul & tsx ./test/refact/device-product-httpdao.test.ts",
        "test:refact:agent": "chcp 65001 >nul & tsx ./test/refact/pom-agent-httpdao.test.ts",
        "test:refact:quickchat": "chcp 65001 >nul & tsx ./test/refact/pom-quick-chat-response-httpdao.test.ts",
        "test:refact:skill": "chcp 65001 >nul & tsx ./test/refact/device-agent-runner-httpdao.test.ts",
        "test:refact:trigger": "chcp 65001 >nul & tsx ./test/refact/pom-trigger-httpdao.test.ts",
        "test:mcp:http": "chcp 65001 >nul & tsx ./test/mcphttp-service-test.ts",
        "test:pom2": "chcp 65001 >nul & tsx ./test/pom2/pom-manager-test.ts",
        "test:socket:load1": "chcp 65001 >nul & tsx ./test/socket-io-client/socket-load-test.ts 1 500 1",
        "test:socket:load2": "chcp 65001 >nul & tsx ./test/socket-io-client/socket-load-test.ts 501 500 2",
        "build": "tsc && tsc-alias && yarn copy-assets",
        "copy-assets": "node -e \"const fs = require('fs'); const path = require('path'); const src = path.join(__dirname, 'assets'); const dest = path.join(__dirname, 'dist', 'assets'); if (!fs.existsSync(path.dirname(dest))) fs.mkdirSync(path.dirname(dest), { recursive: true }); fs.cpSync(src, dest, { recursive: true }); console.log('Assets copied successfully!');\"",
        "start:win:local1": "powershell -Command \"chcp 65001 >$null; $env:NODE_ENV='development'; node --enable-source-maps dist/src/app.js\"",
        "start:win:local2": "powershell -Command \"chcp 65001 >$null; $env:NODE_ENV='prod'; node --enable-source-maps dist/src/app.js\"",
        "start:win:relocal": "yarn build && yarn start:win:local1",
        "start:prod": "node --enable-source-maps dist/src/app.js",
        "lint": "eslint ./src --ext .ts",
        "format": "prettier --write ./src",
        "doc": "docsify serve --port 2000 ./docs",
        "pm2:start": "pm2 start ecosystem.config.cjs --env development",
        "pm2:start:prod": "pm2 start ecosystem.config.cjs --env production",
        "pm2:reload:prod": "pm2 reload ecosystem.config.cjs --env production",
        "pm2:reload": "pm2 reload coco-cloud-ts --update-env",
        "pm2:stop": "pm2 stop coco-cloud-ts || true",
        "pm2:delete": "pm2 delete coco-cloud-ts || true",
        "pm2:logs": "pm2 logs coco-cloud-ts",
        "pm2:list": "pm2 ls",
        "pm2:save": "pm2 save",
        "pm2:startup": "pm2 startup"
    },
    "dependencies": {
        "@fastify/cors": "8.x",
        "@socket.io/admin-ui": "^0.5.1",
        "@socket.io/redis-streams-adapter": "^0.2.2",
        "@volcengine/openapi": "^1.31.1",
        "app-root-path": "^3.1.0",
        "async-lock": "^1.4.1",
        "date-fns": "^4.1.0",
        "date-fns-tz": "^3.2.0",
        "dotenv": "^17.2.1",
        "fast-xml-parser": "^5.3.1",
        "fastify": "4.x",
        "fastify-decorators": "^3.16.1",
        "fastify-i18n": "2.x",
        "fastify-socket.io": "^5.1.0",
        "ioredis": "^5.7.0",
        "microsoft-cognitiveservices-speech-sdk": "^1.46.0",
        "pino": "^9.9.0",
        "pino-pretty": "^13.1.1",
        "pino-roll": "^3.1.0",
        "prom-client": "^15.1.3",
        "redis": "^5.8.2",
        "reflect-metadata": "^0.2.2",
        "socket.io": "^4.8.1",
        "socket.io-client": "^4.8.1",
        "socket.io-msgpack-parser": "^3.0.2",
        "speaker": "^0.5.5",
        "ts-morph": "^27.0.2",
        "uWebSockets.js": "uNetworking/uWebSockets.js#v20.52.0",
        "uniai": "1.20.2",
        "uuid": "^13.0.0",
        "ws": "^8.16.0"
    },
    "devDependencies": {
        "@types/async-lock": "^1.4.2",
        "@types/node": "^24.3.0",
        "@types/ws": "^8.5.10",
        "@typescript-eslint/eslint-plugin": "^8.39.1",
        "@typescript-eslint/parser": "^8.39.1",
        "docsify-cli": "^4.4.4",
        "dotenv-cli": "^10.0.0",
        "eslint": "^9.33.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "pm2": "^6.0.14",
        "prettier": "^3.6.2",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.20.4",
        "typescript": "^5.9.2",
        "xlsx": "^0.18.5"
    }
}
