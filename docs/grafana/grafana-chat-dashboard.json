{
    "title": "Coco Cloud Chat 指标监控仪表板",
    "tags": ["prometheus", "chat"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "30s",
    "templating": {
        "list": [
            {
                "name": "job",
                "allValue": ".*",
                "current": {
                    "label": "Job",
                    "text": "coco-cloud-ts",
                    "value": "coco-cloud-ts"
                },
                "definition": "label_values({job=\"coco-cloud-ts\"},job)",
                "includeAll": false,
                "options": [],
                "query": {
                    "qryType": 1,
                    "query": "label_values({job=\"coco-cloud-ts\"},job)",
                    "refId": "PrometheusVariableQueryEditor-VariableQuery"
                },
                "refresh": 1,
                "sort": 1,
                "type": "query"
            },
            {
                "allValue": ".*",
                "current": {
                    "text": "192.168.10.234:8002",
                    "value": "192.168.10.234:8002"
                },
                "definition": "label_values({job=\"$job\"},instance)",
                "includeAll": false,
                "label": "Instance",
                "name": "instance",
                "options": [],
                "query": {
                    "qryType": 1,
                    "query": "label_values({job=\"$job\"},instance)",
                    "refId": "PrometheusVariableQueryEditor-VariableQuery"
                },
                "refresh": 1,
                "sort": 1,
                "type": "query"
            }
        ]
    },
    "panels": [
        {
            "title": "Agent Chat 关键性能指标（大多延迟指标都是基于xx指标时间-用户尾包时间）",
            "type": "row",
            "gridPos": {
                "x": 0,
                "y": 1,
                "w": 24,
                "h": 1
            },
            "collapsed": false
        },
        {
            "title": "STT完成延迟（P95）",
            "type": "stat",
            "gridPos": {
                "x": 0,
                "y": 2,
                "w": 4,
                "h": 4
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(agent_chat_stt_complete_delay_ms_bucket{job=\"$job\", instance=\"$instance\"}[5m])) by (le))",
                    "legendFormat": "STT完成延迟",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "green"
                            },
                            {
                                "value": 500,
                                "color": "yellow"
                            },
                            {
                                "value": 1000,
                                "color": "red"
                            }
                        ]
                    }
                }
            },
            "options": {
                "graphMode": "area",
                "colorMode": "value",
                "textMode": "value_and_name"
            }
        },
        {
